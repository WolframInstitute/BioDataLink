# Operating system and editor files
.DS_Store
Thumbs.db
*.sw?
*~

# Local tool state: agent sessions, the optional .claude/skills -> ../.agent-skills symlink, nit
.claude/
.nit/
gol-snapshots/

# Build output and packed archives
/build/
/dist/
*.paclet
*.mx

# Documentation notebooks are generated from the Markdown under docs/en by make notebooks;
# BioDataLink/ResourceDefinition.nb is generated by PacletPage from docs/ResourceDefinition.md
*.nb

# Indexes that PacletDocumentationBuild writes next to the notebooks when run in place
BioDataLink/Documentation/**/Index/
BioDataLink/Documentation/**/SearchIndex/
BioDataLink/Documentation/**/SpellIndex/

# Build dependencies fetched from git (the MarkdownToNotebook converter)
/.deps/

# Python
__pycache__/
.venv/

# Local secrets for publishing; never commit
.env
.secrets

# Logs
*.log

# PacletPage builds the archive and its code hash here
BioDataLink/build/

/coordination.md

# Provider downloads and local data caches
.cache/
data/downloads/
*.h5ad
*.h5
*.loom
