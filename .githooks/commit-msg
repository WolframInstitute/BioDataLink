#!/bin/sh
# Conventional Commits check for the first line of a commit message.
# Format:  <type>(<optional scope>)<optional !>: <subject>
# Types:   build chore ci docs feat fix perf refactor revert style test
# Example: feat(catalog): add BioDatasetSearch

message_file="$1"
first_line=$(sed -n '1p' "$message_file")

case "$first_line" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
if ! printf '%s\n' "$first_line" | grep -Eq "^(${types})(\([A-Za-z0-9_./-]+\))?!?: [^ ].*$"; then
    printf '%s\n' \
        "commit-msg: the first line does not follow Conventional Commits:" \
        "  $first_line" \
        "" \
        "  expected: <type>(<scope>): <subject>    e.g. feat(catalog): add BioDatasetSearch" \
        "  types:    ${types}" \
        "  bypass:   git commit --no-verify" >&2
    exit 1
fi

if [ ${#first_line} -gt 72 ]; then
    printf '%s\n' "commit-msg: the first line is longer than 72 characters (${#first_line})." >&2
    exit 1
fi
