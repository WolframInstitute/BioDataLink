# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Wolfram Language sources, scripts and test files
[*.{wl,wls,wlt,m}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,cff,json}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Notebooks are written by the Wolfram front end; leave their formatting alone.
[*.nb]
insert_final_newline = false
trim_trailing_whitespace = false
